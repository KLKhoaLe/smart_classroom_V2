    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx=$json;const m=ctx.metrics||{};const policy=ctx.policy?.config||{};const n=(v)=>Number(v);const recommendations=[];const add=(action,reason,evidence)=>recommendations.push({action,reason,evidence});const temp=n(m.avg_temperature),humidity=n(m.avg_humidity),co2=n(m.avg_co2_ppm),kwh=n(m.estimated_kwh);const incidents=Array.isArray(ctx.incidents)?ctx.incidents:[];\nif(!ctx.eligible){add('Thu thập thêm telemetry trước khi đổi policy','Độ phủ dữ liệu chưa đủ cho tối ưu tuần.',{active_days:n(m.active_days),telemetry_count:n(m.telemetry_count),required_active_days:4,required_telemetry_count:100});}\nelse{if(Number.isFinite(temp)&&Number.isFinite(n(policy.temperature_on))&&temp>=n(policy.temperature_on)-1)add('Xem lại lịch làm mát và mức sử dụng phòng','Nhiệt độ trung bình tuần gần ngưỡng bật quạt.',{avg_temperature:temp,temperature_on:n(policy.temperature_on)});if(Number.isFinite(humidity)&&Number.isFinite(n(policy.humidity_on))&&humidity>=n(policy.humidity_on)-5)add('Kiểm tra thông gió và nguồn ẩm','Độ ẩm trung bình tuần gần ngưỡng policy.',{avg_humidity:humidity,humidity_on:n(policy.humidity_on)});if(Number.isFinite(co2)&&Number.isFinite(n(policy.co2_on))&&co2>=n(policy.co2_on)-150)add('Xem lại thông gió khi có người','CO2 trung bình tuần gần ngưỡng thông gió.',{avg_co2_ppm:co2,co2_on:n(policy.co2_on)});for(const incident of incidents.filter(x=>n(x.count)>0).slice(0,3))add('Điều tra sự cố lặp '+String(incident.type||'ROOM'),'Xem thời điểm sự cố và tình trạng cảm biến/thiết bị trước khi chỉnh policy.',{type:incident.type,severity:incident.severity,count:n(incident.count)});if(recommendations.length===0)add('Giữ policy hiện tại và xem lại tuần sau','Số liệu tuần chưa cho thấy cần đổi ngưỡng.',{avg_temperature:Number.isFinite(temp)?temp:null,avg_humidity:Number.isFinite(humidity)?humidity:null,avg_co2_ppm:Number.isFinite(co2)?co2:null,estimated_kwh:Number.isFinite(kwh)?kwh:null});}\nconst env=typeof $env!=='undefined'?$env:{};\nconst ai_enabled=ctx.eligible&&String(env.WEEKLY_AI_ENABLED||'true').toLowerCase()!=='false'&&String(env.GROQ_API_KEY||'').length>0;\nconst base={room:ctx.room,period_start:ctx.period_start,period_end:ctx.period_end,metrics:{...m,policy:ctx.policy||null,incidents,recommendations,generated_by:'WF12_RULES',data_quality:ctx.eligible?'SUFFICIENT':'INSUFFICIENT'},summary:`Weekly review ${ctx.room} (${ctx.period_start} → ${ctx.period_end}): ${ctx.eligible?'đủ':'chưa đủ'} dữ liệu; ${recommendations.length} đề xuất rule. Chưa thay đổi policy.`};\nreturn {json:{...base,ai_enabled,weekly_context:ctx}};"
      },
