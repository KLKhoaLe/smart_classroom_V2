{
  "name": "04 Device Command Dispatcher",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "flow04-dispatch",
        "options": {
          "responseMode": "lastNode"
        }
      },
      "id": "wh-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "flow04-dispatch"
    },
    {
      "parameters": {
        "jsCode": "// Normalize: n8n webhook wraps body in $json.body\nconst input = $input.first().json;\nconst body = input.body ?? input;\n\nconst command_id = body.command_id;\n\nif (!command_id) {\n  throw new Error('Missing command_id in payload');\n}\n\n// UUID v4 format validation\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nif (!uuidRegex.test(command_id)) {\n  throw new Error('Invalid command_id format: ' + command_id);\n}\n\nreturn [{\n  json: {\n    command_id: command_id,\n    retry_count: body.retry_count ?? 0,\n    max_retries: body.max_retries ?? 3\n  }\n}];"
      },
      "id": "parse-input",
      "name": "Parse & Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "={{$env.BACKEND_URL}}/api/commands/{{ $json.command_id }}/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "id": "get-command",
      "name": "GET Command Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "backend-token",
          "name": "Backend API Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-pending",
              "leftValue": "={{ $json.status }}",
              "rightValue": "PENDING",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-status",
      "name": "Is PENDING?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "// Check TTL: command should not be expired\nconst command = $input.first().json;\nconst expiresAt = new Date(command.expires_at).getTime();\nconst now = Date.now();\n\nif (expiresAt <= now) {\n  return [{\n    json: {\n      command_id: command.command_id ?? command.id,\n      error: 'Command already expired',\n      expires_at: command.expires_at,\n      server_time: new Date().toISOString(),\n      skip_dispatch: true\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...command,\n    command_id: command.command_id ?? command.id,\n    ttl_remaining_ms: expiresAt - now,\n    skip_dispatch: false\n  }\n}];"
      },
      "id": "check-ttl",
      "name": "Check TTL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-skip",
              "leftValue": "={{ $json.skip_dispatch }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ttl-gate",
      "name": "TTL Expired?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_URL}}/api/commands/{{ $json.command_id }}/dispatch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "id": "dispatch-command",
      "name": "POST Dispatch → QUEUED",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "backend-token",
          "name": "Backend API Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-queued",
              "leftValue": "={{ $json.status }}",
              "rightValue": "QUEUED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "verify-dispatch",
      "name": "Dispatch OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1780, 120]
    },
    {
      "parameters": {
        "jsCode": "const cmd = $input.first().json;\nreturn [{\n  json: {\n    success: true,\n    command_id: cmd.command_id ?? cmd.id,\n    status: cmd.status,\n    device_id: cmd.device_id,\n    command_type: cmd.command_type,\n    action: cmd.action,\n    dispatched_at: new Date().toISOString(),\n    message: 'Command dispatched to QUEUED. Simulator will claim via /api/commands/claim.'\n  }\n}];"
      },
      "id": "success-output",
      "name": "Dispatch Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 40]
    },
    {
      "parameters": {
        "jsCode": "// Dispatch failed - command may have been claimed/expired between check and dispatch\nconst cmd = $input.first().json;\nconst retryCount = $('Parse & Validate Input').first().json.retry_count ?? 0;\nconst maxRetries = $('Parse & Validate Input').first().json.max_retries ?? 3;\n\nreturn [{\n  json: {\n    success: false,\n    command_id: cmd.command_id ?? cmd.id,\n    status: cmd.status,\n    error: 'Dispatch did not result in QUEUED status',\n    current_status: cmd.status,\n    retry_count: retryCount,\n    max_retries: maxRetries,\n    can_retry: retryCount < maxRetries\n  }\n}];"
      },
      "id": "dispatch-fail",
      "name": "Dispatch Failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 220]
    },
    {
      "parameters": {
        "jsCode": "// Command not in PENDING → already dispatched, expired, or cancelled\nconst cmd = $input.first().json;\nreturn [{\n  json: {\n    success: false,\n    command_id: cmd.command_id ?? cmd.id,\n    status: cmd.status,\n    error: 'Command not in PENDING state, cannot dispatch',\n    current_status: cmd.status,\n    message: 'Command may already be QUEUED/SENT/ACK/TIMED_OUT/CANCELLED'\n  }\n}];"
      },
      "id": "not-pending",
      "name": "Not PENDING → Skip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "jsCode": "// TTL expired before dispatch\nconst cmd = $input.first().json;\nreturn [{\n  json: {\n    success: false,\n    command_id: cmd.command_id,\n    error: 'Command TTL expired before dispatch',\n    expires_at: cmd.expires_at,\n    message: 'Skipped dispatch; command will be cleaned up by expire API'\n  }\n}];"
      },
      "id": "ttl-expired-output",
      "name": "TTL Expired → Skip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error",
              "value": "=Error in WF04 Dispatch: {{ $json.message ?? $json.error ?? 'Unknown error' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "error-handler",
      "name": "Error Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 520]
    }
  ],
