    {
      "parameters": {
        "jsCode": "const base=$('Build Weekly AI Request').first().json;const r=$json;try{if(r.error||r.statusCode<200||r.statusCode>=300)throw new Error('AI_HTTP');const txt=r.body?.choices?.[0]?.message?.content;if(typeof txt!=='string')throw new Error('AI_EMPTY');const ai=JSON.parse(txt);if(typeof ai.summary!=='string'||!Array.isArray(ai.recommendations)||ai.recommendations.length>6)throw new Error('AI_SCHEMA');for(const x of ai.recommendations)if(!x||typeof x.action!=='string'||typeof x.reason!=='string'||!x.evidence||typeof x.evidence!=='object'||Array.isArray(x.evidence))throw new Error('AI_ITEM');return {json:{room:base.room,period_start:base.period_start,period_end:base.period_end,metrics:{...base.metrics,recommendations:ai.recommendations,generated_by:'WF12_AI',ai_model:String((typeof $env!=='undefined'?$env.GROQ_MODEL:'')||'openai/gpt-oss-20b'),rule_fallback:base.metrics.recommendations},summary:ai.summary.slice(0,5000)}};}catch(e){return {json:{...base,metrics:{...base.metrics,generated_by:'WF12_RULE_FALLBACK',ai_error:e.message},summary:base.summary+' AI không khả dụng/không hợp lệ, giữ rule fallback.'}};}"
