        "jsCode": "const response=$json;\nconst source=$('Validate Telemetry').first().json;\nconst status=response.statusCode;\nconst body=response.body;\nif(!Number.isInteger(status)) throw new Error('Không nhận được statusCode. Kiểm tra Full Response của Save Telemetry.');\nif(status>=200&&status<300){\n if(typeof body?.created!=='boolean'||!body?.telemetry?.id||!body?.telemetry?.raw_payload)throw new Error('Backend response sai contract v2.');\n return {json:{saved:true,created:body.created,telemetry:body.telemetry,max_age_seconds:source.max_age_seconds}};\n}\nif([400,404,409,422].includes(status)) return {json:{saved:false,error_record:{device_code:source.error_record.device_code,reason:'BACKEND_REJECTED_HTTP_'+status+' | '+JSON.stringify(body),raw_payload:source.telemetry_payload}}};\nthrow new Error('Backend HTTP '+status+': '+JSON.stringify(body));\n"
