    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json.input;\nconst config = $json.config;\nconst errors = [];\nif ($json.source_authenticated !== true) errors.push('Nguồn gửi telemetry không được xác thực.');\nlet data = input;\nif (typeof data === 'string') {\n  try { data = JSON.parse(data); } catch { errors.push('Body không phải JSON hợp lệ.'); }\n}\nif (!data || typeof data !== 'object' || Array.isArray(data)) {\n  errors.push('Body phải là một JSON object.'); data = {};\n}\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nfor (const key of ['event_id','run_id']) if(typeof data[key] !== 'string' || !uuid.test(data[key])) errors.push(`${key} phải là UUID hợp lệ.`);\nif(typeof data.device_id !== 'string' || !data.device_id.trim() || data.device_id.length > 100) errors.push('device_id phải là mã thiết bị hoặc UUID.');\nif(!Number.isSafeInteger(data.sequence) || data.sequence < 0) errors.push('sequence phải là số nguyên không âm.');\nconst ranges = {temperature:[-10,60],humidity:[0,100],light_percent:[0,100],occupancy_count:[0,100],co2_ppm:[300,5000],power_w:[0,20000]};\nfor(const [key,[min,max]] of Object.entries(ranges)) {\n  const v=data[key];\n  if(typeof v!=='number'||!Number.isFinite(v)||v<min||v>max) errors.push(`${key} phải là số từ ${min} đến ${max}.`);\n}\nif(!Number.isInteger(data.occupancy_count)) errors.push('occupancy_count phải là số nguyên.');\nif(typeof data.door_open!=='boolean') errors.push('door_open phải là boolean.');\nconst time = typeof data.observed_at==='string' && /^\\d{4}-\\d\\d-\\d\\dT.*(?:Z|[+-]\\d\\d:\\d\\d)$/.test(data.observed_at) ? Date.parse(data.observed_at) : NaN;\nif(!Number.isFinite(time)) errors.push('observed_at phải là ISO timestamp có múi giờ.');\nelse if(time > Date.now()+60000) errors.push('observed_at vượt quá 60 giây trong tương lai.');\nfor(const key of ['simulated','occupancy']) if(data[key]!==undefined && typeof data[key]!=='boolean') errors.push(`${key} phải là boolean.`);\nif(typeof data.occupancy==='boolean' && data.occupancy!==(data.occupancy_count>0)) errors.push('occupancy không khớp occupancy_count.');\nfor(const key of ['device_code','room','room_code']) if(data[key]!==undefined&&(typeof data[key]!=='string'||!data[key].trim()||data[key].length>100)) errors.push(`${key} không hợp lệ.`);\nif(data.schema_version!==undefined && data.schema_version!==2)errors.push('Chỉ hỗ trợ telemetry schema_version 2 (khác với tên workflow V3).');\nif(data.light_raw!==undefined && (!Number.isInteger(data.light_raw)||data.light_raw<0||data.light_raw>4095))errors.push('light_raw phải là số nguyên từ 0 đến 4095.');\nfor(const [key,max] of [['pm25_ug_m3',500],['water_l_min',100]]) if(data[key]!==undefined&&(typeof data[key]!=='number'||!Number.isFinite(data[key])||data[key]<0||data[key]>max)) errors.push(`${key} không hợp lệ.`);\nif(data.actual_state!==undefined && (!data.actual_state || typeof data.actual_state!=='object'||Array.isArray(data.actual_state))) errors.push('actual_state phải là object.');\nconst fields=['device_id','device_code','event_id','run_id','sequence','observed_at','temperature','humidity','light_percent','occupancy_count','co2_ppm','power_w','door_open','simulated','occupancy','room','room_code','light_raw','schema_version','actual_state','pm25_ug_m3','water_l_min'];\nconst payload=Object.fromEntries(fields.filter(k=>data[k]!==undefined).map(k=>[k,data[k]]));\nconst raw = input && typeof input==='object'&&!Array.isArray(input) ? input : {received_body:input??null};\nreturn {json:{valid:errors.length===0,errors,telemetry_payload:payload,\n error_record:{device_code:typeof data.device_code==='string'?data.device_code.slice(0,80):typeof data.device_id==='string'?data.device_id.slice(0,80):undefined,reason:errors.join(' | ')||'UNKNOWN_VALIDATION_ERROR',raw_payload:raw},\n max_age_seconds:config.max_age_seconds}};\n"
      },
