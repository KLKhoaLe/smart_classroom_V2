      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const env = typeof $env !== 'undefined' ? $env : {};\nconst raw = $json;\nconst input = raw.body ?? raw;\nconst expectedToken = String(env.SIMULATOR_WEBHOOK_TOKEN || '').trim();\nconst auth=String(raw.headers?.authorization||'');\nconst receivedToken = String(raw.headers?.['x-smart-classroom-token'] || raw.headers?.['X-Smart-Classroom-Token'] || (auth.startsWith('Bearer ')?auth.slice(7):'')).trim();\nconst source_authenticated = !expectedToken || receivedToken === expectedToken;\nconst base_url = String(env.BACKEND_BASE_URL || 'https://smart-classroom-backend-allm.onrender.com').replace(/\\/+$/, '');\nconst n8n_public_url = String(env.N8N_PUBLIC_URL || env.WEBHOOK_URL || '').replace(/\\/+$/, '');\nreturn {json:{input,source_authenticated,config:{base_url,n8n_public_url,max_age_seconds:120}}};"
      },
      "id": "ab4ffec9-7329-4dce-b425-581aa87d3139",
      "name": "Configuration",
      "type": "n8n-nodes-base.code",
